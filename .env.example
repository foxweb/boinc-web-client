# Required (default GUI RPC password for the local BOINC client)
BOINC_PASSWORD=change-me

# HTTP port published by Docker
PORT=8080

# Default GUI RPC target (overridable in the web UI settings form)
BOINC_HOST=127.0.0.1
BOINC_PORT=31416

# In Docker, the web container talks to BOINC through a host-network unix-socket
# proxy (see compose.yaml). Settings host/port rewrite the proxy upstream so
# remote LAN clients (TCP 31416) work without forcing local-only mode.

HISTORY_INTERVAL_MS=5000
HISTORY_MAX_POINTS=240
