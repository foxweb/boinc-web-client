# Required
BOINC_PASSWORD=change-me

# HTTP port published by Docker
PORT=8080

# Real BOINC GUI RPC on the host (used by boinc-proxy)
BOINC_PORT=31416

# docker0 bind for the BOINC TCP proxy (default Docker bridge)
PROXY_BIND=172.17.0.1
PROXY_PORT=31417

HISTORY_INTERVAL_MS=5000
HISTORY_MAX_POINTS=240
